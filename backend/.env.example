DB_HOST=localhost
DB_PORT=5432
DB_NAME=barberconnect
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres
# Alternativa para provedores gerenciados (Render, Neon, Supabase etc.).
# Se DATABASE_URL for definida, as variáveis DB_* acima não são usadas.
DATABASE_URL=
DB_SSL=false
JWT_SECRET=troque_por_um_segredo_grande
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# SMTP é opcional: sem estas variáveis, as notificações continuam dentro do aplicativo.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_usuario_smtp
SMTP_PASS=sua_senha_smtp
SMTP_FROM="BarberConnect <no-reply@barberconnect.local>"
# Opcional: URL de conexão do Cloudinary para armazenar portfólios fora do servidor local.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Controles operacionais de reservas.
MAX_ACTIVE_BOOKINGS_PER_CLIENT_BARBERSHOP=2
URGENT_COOLDOWN_MINUTES=15
